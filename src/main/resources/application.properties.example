spring.application.name=planIMRT

spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/planimrt_db}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:changeme}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=update
spring.sql.init.mode=always
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=false

server.port=${SERVER_PORT:8080}

spring.servlet.multipart.max-file-size=100MB

file.storage.path=${FILE_STORAGE_PATH:./uploads}

logging.level.root=ERROR
logging.level.com.planimrt=ERROR
logging.level.org.hibernate.SQL=ERROR
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=ERROR
logging.level.org.hibernate.type=ERROR
logging.level.com.zaxxer.hikari=ERROR
logging.level.org.springframework.jdbc=ERROR